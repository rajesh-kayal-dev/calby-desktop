{
  "name": "calby",
  "version": "1.0.0",
  "private": true,
  "description": "Calby — Personal Desktop Assistant",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@calby/desktop",
    "build": "npm run build --workspace=@calby/desktop",
    "lint": "npm run lint --workspace=@calby/desktop",
    "typecheck": "npm run typecheck --workspace=@calby/desktop"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "typescript": "^5.3.3"
  }
}
