{
  "name": "calby",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Calby — Personal Desktop Assistant",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@calby/desktop",
    "build": "npm run build --workspace=@calby/desktop",
    "lint": "npm run lint --workspace=@calby/desktop",
    "typecheck": "npm run typecheck --workspace=@calby/desktop",
    "test": "npm run test --workspace=@calby/desktop",
    "build:win": "npm run build:win --workspace=@calby/desktop",
    "build:mac": "npm run build:mac --workspace=@calby/desktop",
    "build:linux": "npm run build:linux --workspace=@calby/desktop",
    "build:all": "npm run build:win && npm run build:mac && npm run build:linux",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.63.4",
    "@rollup/rollup-darwin-x64": "4.63.4",
    "@rollup/rollup-linux-x64-gnu": "4.63.4",
    "@rollup/rollup-win32-x64-msvc": "4.63.4"
  }
}
